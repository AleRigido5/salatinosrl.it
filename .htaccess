<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Reindirizza solo salatinosrl.it a gestionale.salatinosrl.it
    RewriteCond %{HTTP_HOST} ^salatinosrl\.it$ [NC,OR]
    RewriteCond %{HTTP_HOST} ^www\.salatinosrl\.it$ [NC]
    RewriteRule ^(.*)$ https://gestionale.salatinosrl.it/$1 [R=301,L]
    
    # IMPORTANTE: Non aggiungere altre regole qui!
    # Il sottodominio gestionale.salatinosrl.it deve essere gestito 
    # dal suo .htaccess interno alla cartella gestionale/public/
</IfModule>